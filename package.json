{
  "name": "@vibecontrols/vibe-plugin-security",
  "version": "2026.601.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "description": "Security lifecycle orchestrator — dispatches to per-stage security providers (secrets, sbom, release-gate, etc.).",
  "engines": {
    "bun": ">=1.4.4"
  },
  "author": {
    "name": "Vignesh T.V",
    "url": "https://github.com/tvvignesh"
  },
  "license": "MIT",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./types": {
      "import": "./dist/types.js",
      "types": "./dist/types.d.ts"
    },
    "./tool-installer": {
      "import": "./dist/tool-installer.js",
      "types": "./dist/tool-installer.d.ts"
    },
    "./fingerprint": {
      "import": "./dist/fingerprint.js",
      "types": "./dist/fingerprint.d.ts"
    },
    "./normalizer": {
      "import": "./dist/normalizer.js",
      "types": "./dist/normalizer.d.ts"
    }
  },
  "scripts": {
    "build": "bun build ./src/index.ts ./src/types.ts ./src/tool-installer.ts ./src/fingerprint.ts ./src/normalizer.ts --outdir ./dist --target bun --minify-syntax --minify-whitespace --external elysia && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "lint": "eslint .",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "type:check": "boff gate -- bun check --no-pretty",
    "test": "bun test",
    "clean": "rimraf dist",
    "prebuild": "bun run clean",
    "prepublishOnly": "bun run build",
    "sanity": "boff sanity",
    "sanity:force": "boff sanity --force",
    "audit": "bun audit --audit-level=high"
  },
  "dependencies": {
    "@vibecontrols/plugin-sdk": "2026.601.1",
    "elysia": "^1.4.2"
  },
  "devDependencies": {
    "@burdenoff/toolchain": "2026.1107.14",
    "@types/bun": "^1.4.4",
    "eslint": "^9.39.5",
    "knip": "^6.44.1",
    "rimraf": "^6.1.4",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "@vibecontrols/agent": ">=2026.428.0"
  },
  "peerDependenciesMeta": {
    "@vibecontrols/agent": {
      "optional": true
    }
  },
  "keywords": [
    "vibecontrols",
    "vibe",
    "vibe-plugin",
    "security",
    "sast",
    "sca",
    "sbom",
    "secrets",
    "policy",
    "opa",
    "supply-chain",
    "bun"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Algoshred/vibe-plugin-security.git"
  },
  "bugs": {
    "url": "https://github.com/Algoshred/vibe-plugin-security/issues"
  },
  "homepage": "https://vibecontrols.com",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist/**/*",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "packageManager": "bun@1.4.4",
  "boff": {
    "type": "plugin",
    "sanity": {
      "steps": [
        "format",
        "lint",
        "typecheck",
        "build",
        "test",
        "knip"
      ]
    }
  },
  "overrides": {
    "brace-expansion": ">=5.0.12",
    "minimatch": ">=3.1.3"
  }
}
